# Copy to .env for local dev.  Never commit the real .env.

PORT=3000

# MongoDB connection string (same value as the MONGODB_URI GitHub secret)
MONGODB_URI=mongodb://127.0.0.1:27017/brewandco

# Secret used to sign/verify login tokens (JWT). Must be a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production - the server refuses to start without it.
JWT_SECRET=dev-only-insecure-secret-change-me

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional: Sentry error reporting
SENTRY_DSN=
